# Локальная разработка. На Render переменные задаются в панели сервиса (см. render.yaml).

# Токен ТЕСТОВОГО бота от @BotFather (не боевого с Render)
BOT_TOKEN=123456:replace-me
# ID чата букеров (супергруппа, куда добавлен бот). Узнать: добавь бота в группу и отправь /chat_id
BOOKER_CHAT_ID=
# Название площадки в текстах бота
VENUE_NAME=Клуб Гараж
# polling — локально (туннель не нужен); webhook — на хостинге
BOT_MODE=polling
